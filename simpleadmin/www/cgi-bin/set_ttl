#!/bin/bash
. "$(dirname "$0")/_lib.sh"

parse_query "ttlvalue"

echo "Content-type: application/json"
echo ""

debug_logs=()
log_debug() { debug_logs+=("$1"); }

# Validate: ttlvalue must be an integer 0..255.
case "$ttlvalue" in
    ''|*[!0-9]*) log_debug "Invalid ttlvalue: $ttlvalue"; ttlvalue="" ;;
esac
if [ -n "$ttlvalue" ] && [ "$ttlvalue" -gt 255 ]; then
    log_debug "ttlvalue out of range (>255): $ttlvalue"
    ttlvalue=""
fi

if [ -n "$ttlvalue" ]; then
    log_debug "Stopping service to remove rules"
    /usrdata/simplefirewall/ttl-override stop

    if [ "$ttlvalue" -eq 0 ]; then
        log_debug "Disabling TTL"
        /usrdata/simpleadmin/script/ttl_script.sh disable 0
    else
        log_debug "Enabling TTL with value: $ttlvalue"
        /usrdata/simpleadmin/script/ttl_script.sh enable "$ttlvalue"
    fi

    log_debug "Starting service to apply rules"
    /usrdata/simplefirewall/ttl-override start
fi

# Emit JSON. Logs are plain ASCII from controlled strings, no escaping needed.
printf '{"debug_logs":['
sep=""
for line in "${debug_logs[@]}"; do
    printf '%s"%s"' "$sep" "$line"
    sep=","
done
printf ']}\n'
