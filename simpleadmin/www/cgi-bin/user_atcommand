#!/bin/bash
. "$(dirname "$0")/_lib.sh"

parse_query "atcmd"

echo "Content-type: text/plain"
echo ""

[ -z "$atcmd" ] && { echo ""; exit 0; }

# Run through atcmd binary (socat-at-bridge interactive). Strip ANSI codes.
runcmd=$(atcmd "$atcmd" | awk '{ gsub(/\x1B\[[0-9;]*[mG]/, "") }1')

echo "$atcmd"
echo ""
echo "$runcmd"
