#!/bin/bash

# Read the iptables mangle table and extract the configured TTL value via the
# --ttl-set flag so the parser does not depend on iptables column layout.
rules=$(/opt/bin/sudo /usr/sbin/iptables -w 5 -t mangle -S 2>/dev/null)
ttlvalue=$(printf '%s\n' "$rules" | grep -oE 'ttl-set [0-9]+' | awk '{print $2}' | head -n1)

if [ -z "$ttlvalue" ]; then
    ttlvalue=0
    ttlenabled=false
else
    ttlenabled=true
fi

echo "Content-type: application/json"
echo ""
printf '{"isEnabled":%s,"ttl":%s}\n' "$ttlenabled" "$ttlvalue"
