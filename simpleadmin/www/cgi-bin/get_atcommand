#!/bin/bash
. "$(dirname "$0")/_lib.sh"

parse_query "atcmd"

echo "Content-type: text/plain"
echo ""

[ -z "$atcmd" ] && { echo ""; exit 0; }

# Send AT command over /dev/ttyOUT2. Start with 200ms wait, bump by 200ms each
# loop until we see OK or ERROR. Cap at 20 iterations (~42s ceiling) so QSCAN
# and other slow commands finish without hanging the request forever.
wait_time=200
runcmd=""
for _ in $(seq 1 20); do
    runcmd=$(printf '%s\r\n' "$atcmd" | microcom -t "$wait_time" /dev/ttyOUT2)
    case "$runcmd" in
        *OK*|*ERROR*) break ;;
    esac
    wait_time=$((wait_time + 200))
done

echo "$atcmd"
echo ""
echo "$runcmd"
