#!/bin/bash
. "$(dirname "$0")/_lib.sh"

parse_query "number msg Command"

echo "Content-type: text/plain"
echo ""

if [ -z "$number" ] || [ -z "$msg" ]; then
    echo "ERROR: missing number or msg"
    exit 0
fi

# Phone number must be UCS2-encoded hex (uppercase, even length) from frontend.
case "$number" in
    *[!0-9A-Fa-f]*|'') echo "ERROR: invalid number"; exit 0 ;;
esac
# Same shape for msg.
case "$msg" in
    *[!0-9A-Fa-f]*|'') echo "ERROR: invalid msg"; exit 0 ;;
esac
# Command is "uid,seq,total" — digits and commas only.
case "$Command" in
    *[!0-9,]*) echo "ERROR: invalid Command"; exit 0 ;;
esac

at_to_modem() {
    printf '%s\r' "$1" | microcom -t 100 /dev/ttyOUT2
}

if [ -n "$Command" ]; then
    at_to_modem "AT+CMGS=\"$number\",$Command"
else
    at_to_modem "AT+CMGS=\"$number\""
fi

# Send the body followed by Ctrl-Z (0x1A) which the modem treats as send.
runcmd=$( { printf '%s' "$msg"; printf '\x1A'; } | microcom -t 500 /dev/ttyOUT2 )
echo "$runcmd"
