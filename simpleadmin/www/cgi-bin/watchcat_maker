#!/bin/bash
. "$(dirname "$0")/_lib.sh"

parse_query "WATCHCAT_ENABLED TRACK_IP PING_TIMEOUT PING_FAILURE_COUNT"

# Defaults if frontend omitted any field.
: "${WATCHCAT_ENABLED:=disable}"
: "${TRACK_IP:=1.1.1.1}"
: "${PING_TIMEOUT:=30}"
: "${PING_FAILURE_COUNT:=3}"

echo "Content-type: text/plain"
echo ""

# Validate every input before touching the system.
case "$WATCHCAT_ENABLED" in
    enable|disable) ;;
    *) echo "Invalid value for WATCHCAT_ENABLED. Use 'enable' or 'disable'."; exit 1 ;;
esac

if ! [[ "$TRACK_IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    echo "Invalid IP address format for TRACK_IP."
    exit 1
fi

case "$PING_TIMEOUT" in
    ''|*[!0-9]*) echo "PING_TIMEOUT must be a positive integer."; exit 1 ;;
esac
[ "$PING_TIMEOUT" -le 0 ] && { echo "PING_TIMEOUT must be a positive integer."; exit 1; }

case "$PING_FAILURE_COUNT" in
    ''|*[!0-9]*) echo "PING_FAILURE_COUNT must be a positive integer."; exit 1 ;;
esac
[ "$PING_FAILURE_COUNT" -le 0 ] && { echo "PING_FAILURE_COUNT must be a positive integer."; exit 1; }

if [ "$WATCHCAT_ENABLED" = "enable" ]; then
    echo "Watchcat is enabled. Tracking IP: $TRACK_IP, Ping timeout: $PING_TIMEOUT seconds, Ping failure count: $PING_FAILURE_COUNT"
    sudo /usrdata/simpleadmin/script/create_watchcat.sh "$TRACK_IP" "$PING_TIMEOUT" "$PING_FAILURE_COUNT"
else
    echo "Watchcat is disabled."
    sudo /usrdata/simpleadmin/script/remove_watchcat.sh
fi
